# ─── Instagram / Meta ───────────────────────────────────────────────────────
IG_APP_ID=
IG_APP_SECRET=
# Long-lived access token (60 days). Generate via Graph API Explorer, then exchange.
IG_ACCESS_TOKEN=
# Numeric Instagram professional account ID — GET /me?fields=id,username
IG_BUSINESS_ACCOUNT_ID=
# Any string you choose; used to verify Meta's webhook handshake
IG_WEBHOOK_VERIFY_TOKEN=

# ─── Google Sheets ──────────────────────────────────────────────────────────
# The long string between /d/ and /edit in your Sheet's URL
GOOGLE_SHEET_ID=
# client_email from the downloaded service-account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Base64 encode the ENTIRE service-account JSON key file:
#   macOS/Linux:  base64 -i service-account.json
#   Windows PS:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_SERVICE_ACCOUNT_KEY_B64=

# ─── Google Cloud Storage (fallback image hosting) ──────────────────────────
# Only needed if the Drive primary upload fails.
GCS_BUCKET_NAME=

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
# Set to your Vercel frontend URL in production, e.g. https://your-app.vercel.app
CORS_ORIGIN=*
